{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moma.local/schemas/page-analysis.schema.json",
  "title": "MOMA Space Page Analysis",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "output_mode",
    "page_type",
    "needs_database",
    "databases",
    "sdk",
    "assets",
    "signals",
    "source",
    "confidence"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1 },
    "output_mode": {
      "enum": ["static", "database-readonly", "database-readwrite"]
    },
    "page_type": { "enum": ["display", "form", "mixed"] },
    "needs_database": {
      "type": "object",
      "required": ["level", "reason"],
      "properties": {
        "level": { "enum": ["strong", "medium", "weak", "none"] },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "databases": {
      "type": "array",
      "items": { "$ref": "#/$defs/database" }
    },
    "sdk": {
      "type": "object",
      "required": ["uses_current_sdk", "methods", "database_ids"],
      "properties": {
        "uses_current_sdk": { "type": "boolean" },
        "methods": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "query",
              "addRecord",
              "getRecord",
              "updateRecord",
              "deleteRecord",
              "getSchema",
              "uploadImage",
              "onUpdated"
            ]
          }
        },
        "database_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "signals": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "source": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "confidence": { "enum": ["high", "medium", "low"] }
  },
  "additionalProperties": false,
  "$defs": {
    "database": {
      "type": "object",
      "required": ["title", "properties", "bindings"],
      "properties": {
        "source_database_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "title": { "type": "string", "minLength": 1 },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "config"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "config": { "type": "object" }
            },
            "additionalProperties": false
          }
        },
        "bindings": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/binding" }
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["value_type", "write_support"],
      "properties": {
        "value_type": {
          "enum": ["text", "number", "select", "multi_select", "unknown"]
        },
        "write_support": { "enum": ["confirmed", "readonly", "unknown"] },
        "form_selector": { "type": "string", "minLength": 1 },
        "display_selector": { "type": "string", "minLength": 1 },
        "render_signal": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["source", "kind", "resolution"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["image", "stylesheet", "script", "font", "other"]
        },
        "resolution": {
          "enum": ["inline", "uploaded", "remote", "unresolved"]
        }
      },
      "additionalProperties": false
    }
  }
}
